# Copie para .env e preencha. O .env NÃO vai para o git.

# --- LNS (VPN-SERVER) ---
# IP público do LNS (VPN-SERVER). Peça ao NOC; o start.sh pergunta se estiver vazio.
LNS_IP=
IPSEC_PSK=troque-me
L2TP_USER=troque-me
L2TP_PASS=troque-me

# Propostas IKEv1/ESP (opcional; padrão cobre MikroTik/Cisco/Huawei comuns)
#IPSEC_IKE=aes256-sha1-modp2048,aes128-sha1-modp2048,aes256-sha1-modp1024,aes128-sha1-modp1024,3des-sha1-modp1024
#IPSEC_ESP=aes256-sha1,aes128-sha1,3des-sha1

# MTU da sessão PPP
PPP_MTU=1400
# Opções extras do pppd, separadas por ";" (ex.: "require-mschap-v2;debug")
#PPP_EXTRA_OPTS=

# --- Rede de trânsito vpn <-> frr/host ---
TRANSIT_SUBNET=128.128.0.0/24
TRANSIT_HOST_IP=128.128.0.1
TRANSIT_VPN_IP=128.128.0.2

# --- BGP ---
BGP_LOCAL_AS=65000
BGP_REMOTE_AS=65000
# "auto" = usa o IP do peer da sessão PPP
BGP_NEIGHBOR=auto
# "auto" = usa o IP local recebido na sessão PPP
BGP_ROUTER_ID=auto
# Prefixos que este host anuncia para o LNS, separados por espaço (vazio = não anuncia nada)
BGP_NETWORKS=
# Aceitar rota default vinda do LNS? (no = todo o resto do tráfego continua saindo pela internet do host)
BGP_ACCEPT_DEFAULT=no
